# =============================================================================
# Multshool — Docker Compose root env
# Copy to .env:  cp .env.example .env
# Then:          docker compose up --build -d
# =============================================================================

APP_ENV=local
APP_DEBUG=true
NODE_ENV=development

# Shared Laravel APP_KEY (leave empty to auto-generate per service from its own .env)
APP_KEY=

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=multshool
MYSQL_PASSWORD=multshool
MYSQL_DATABASE=ms-users-api
MYSQL_HOST_PORT=3306

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
RABBITMQ_EMAIL_EXCHANGE=email_exchange
RABBITMQ_EMAIL_QUEUE=email_queue
RABBITMQ_USER_EVENTS_EXCHANGE=user_events
# Filas/routing keys são por serviço no docker-compose (exchange direct).
# NÃO uses ROUTING_KEY=# — em exchange direct isso não é wildcard.
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_PORT=15672
AMQP_CONNECTION=default

# -----------------------------------------------------------------------------
# Auth / inter-service secrets (must stay aligned across APIs)
# -----------------------------------------------------------------------------
JWT_SECRET=qwertyuiopqwertyuiouytrewaszdfhjyezdxfjcvkjcrtrdcrsxdrfg
JWT_ALGO=HS256

# Per-service inbound secrets (Compose maps each service API_SECRET from these)
# users.API_SECRET  <= USERS_API_SECRET
# school.API_SECRET <= SCHOOL_API_SECRET
# student.API_SECRET<= STUDENT_API_SECRET
USERS_API_SECRET=ah6d8jO0UTVXvuHYfoe2rM91lDpAqJ3Q
SCHOOL_API_SECRET=seu-secret-super-seguro-aqui
STUDENT_API_SECRET=seu-secret-aqui

# Deprecated alias (do NOT inject into all containers as API_SECRET)
# API_SECRET=ah6d8jO0UTVXvuHYfoe2rM91lDpAqJ3Q

AUTO_VERIFY_EMAILS=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Postmark (ms-message-api) — optional for local; emails fail without a real token
# -----------------------------------------------------------------------------
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@example.com
POSTMARK_FROM_NAME=MultiShol

# -----------------------------------------------------------------------------
# Browser-facing frontend URLs
# Use localhost locally; on VPS set PUBLIC_HOST to the public IP/domain.
# -----------------------------------------------------------------------------
# IP/domínio público da VPS (frontends no browser)
PUBLIC_HOST=54.196.176.24
NEXT_PUBLIC_USERS_API_URL=http://54.196.176.24:8000/api
NEXT_PUBLIC_STUDENT_API_URL=http://54.196.176.24:8001/api
NEXT_PUBLIC_SCHOOL_API_URL=http://54.196.176.24:8003/api
NEXT_PUBLIC_ADMIN_API_URL=http://54.196.176.24:8002/api
NEXT_PUBLIC_BILLING_API_URL=http://54.196.176.24:8004/api

STATIC_HTML_PORT=8080

# Optional: do not expose DB/Redis/RabbitMQ publicly on VPS (set empty to skip publish)
# MYSQL_HOST_PORT=
# REDIS_HOST_PORT=
# RABBITMQ_HOST_PORT=
# RABBITMQ_MGMT_PORT=
