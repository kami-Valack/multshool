# =============================================================================
# Multshool — Docker Compose root env
# Copy to .env:  cp .env.example .env
# Then:          docker compose up --build -d
# =============================================================================

APP_ENV=local
APP_DEBUG=true
NODE_ENV=development

# Shared Laravel APP_KEY (leave empty to auto-generate per service from its own .env)
APP_KEY=

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=multshool
MYSQL_PASSWORD=multshool
MYSQL_DATABASE=ms-users-api
MYSQL_HOST_PORT=3306

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
RABBITMQ_EMAIL_EXCHANGE=email_exchange
RABBITMQ_EMAIL_QUEUE=email_queue
RABBITMQ_USER_EVENTS_EXCHANGE=user_events
RABBITMQ_USER_EVENTS_QUEUE=user_replication_queue
RABBITMQ_USER_EVENTS_ROUTING_KEY=#
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_PORT=15672
AMQP_CONNECTION=default

# -----------------------------------------------------------------------------
# Auth / inter-service secrets (must stay aligned across APIs)
# -----------------------------------------------------------------------------
JWT_SECRET=qwertyuiopqwertyuiouytrewaszdfhjyezdxfjcvkjcrtrdcrsxdrfg
JWT_ALGO=HS256

# Users API secret (also USERS_API_SECRET for school → users calls)
API_SECRET=ah6d8jO0UTVXvuHYfoe2rM91lDpAqJ3Q
USERS_API_SECRET=ah6d8jO0UTVXvuHYfoe2rM91lDpAqJ3Q

# School API secret (admin/student → school)
SCHOOL_API_SECRET=seu-secret-super-seguro-aqui

# Student API secret (school → student)
STUDENT_API_SECRET=seu-secret-aqui

AUTO_VERIFY_EMAILS=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Postmark (ms-message-api) — optional for local; emails fail without a real token
# -----------------------------------------------------------------------------
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@example.com
POSTMARK_FROM_NAME=MultiShol

# -----------------------------------------------------------------------------
# Browser-facing frontend URLs
# Use localhost locally; on VPS set PUBLIC_HOST to the public IP/domain.
# -----------------------------------------------------------------------------
PUBLIC_HOST=localhost
NEXT_PUBLIC_USERS_API_URL=http://${PUBLIC_HOST}:8000/api
NEXT_PUBLIC_STUDENT_API_URL=http://${PUBLIC_HOST}:8001/api
NEXT_PUBLIC_SCHOOL_API_URL=http://${PUBLIC_HOST}:8003/api
NEXT_PUBLIC_ADMIN_API_URL=http://${PUBLIC_HOST}:8002/api
NEXT_PUBLIC_BILLING_API_URL=http://${PUBLIC_HOST}:8004/api

STATIC_HTML_PORT=8080

# Optional: do not expose DB/Redis/RabbitMQ publicly on VPS (set empty to skip publish)
# MYSQL_HOST_PORT=
# REDIS_HOST_PORT=
# RABBITMQ_HOST_PORT=
# RABBITMQ_MGMT_PORT=
